# Optional: chỉ cần khi muốn dùng LLM để sinh câu trả lời tự nhiên.
GEMINI_API_KEY=AIzaSyCbRToqS-Shy29ahnXDMyTGZrGGPVGh3Oc
GEMINI_MODEL=gemini-2.5-flash

# Embedding model local. Có thể đổi sang model multilingual khác của sentence-transformers.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# OCR language: vie = Vietnamese, eng = English.
OCR_LANG=vie+eng

# Windows example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=C:\ProgramData\Microsoft\Windows\Start Menu\Programs\Tesseract-OCR\tesseract.exe
